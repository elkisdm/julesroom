# Copia a .env en el servidor (no commitees .env). Genera clave y secreto con alta entropía.

# Credenciales de la API de LiveKit (mismo par que usará el emisor de tokens).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# URL pública de señalización que verán los clientes (wss).
# Ejemplo: wss://vivo.tu-dominio.ejemplo
LIVEKIT_URL=

# IP pública del VPS (opcional; si STUN falla, fija node_ip en livekit.yaml).
LIVEKIT_NODE_IP=

# Certificados para TURN/TLS (5349). Rutas absolutas en el servidor, p. ej. Let's Encrypt.
LIVEKIT_TURN_CERT=
LIVEKIT_TURN_KEY=

# Dominio que debe coincidir con turn.domain en livekit.yaml (edítalo al desplegar).
# Suele ser un subdominio dedicado al TURN integrado.

# Origen exacto de la página, sin barra final ni ruta: https://demo.tu-dominio.ejemplo
DEMO_ORIGEN=
# Vacío permite entrar a cualquiera con un enlace; con valor exige el código de demo.
DEMO_LLAVE=
# Vacío agrupa por IP de la conexión. Configura sólo si un proxy confiable la reemplaza.
# Nunca uses una cabecera recibida del cliente sin sobrescribirla en el proxy.
DEMO_CABECERA_IP=
DEMO_MAX_SALAS=10
DEMO_PASES_MINUTO=120
DEMO_INTENTOS_IP_MINUTO=30
DEMO_TOPE_SALA=25
DEMO_TTL_PASE_SEGUNDOS=300
DEMO_TTL_SALA_SEGUNDOS=14400
