FROM node:22.16.0-bookworm-slim AS compilacion
WORKDIR /fuentes
RUN corepack enable && corepack prepare pnpm@10.0.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile --ignore-scripts
# esbuild ya viene con Vite; no agrega dependencias ni ejecuta servidores de desarrollo.
RUN cd apps/lab && node --input-type=module -e "import {createRequire} from 'node:module'; const require = createRequire(import.meta.url); const esbuild = createRequire(require.resolve('vite'))('esbuild'); await esbuild.build({entryPoints:['../sala/server/main-demo.ts'],bundle:true,platform:'node',target:'node22',format:'cjs',outfile:'/salida/emisor.cjs'});"

FROM node:22.16.0-bookworm-slim
ENV NODE_ENV=production HOST=0.0.0.0 PUERTO=5370
WORKDIR /app
COPY --from=compilacion --chown=node:node /salida/emisor.cjs ./emisor.cjs
USER node
EXPOSE 5370
CMD ["node", "emisor.cjs"]
