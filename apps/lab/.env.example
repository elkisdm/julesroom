# Pareja opcional para la demo publicada. Sin ambas, la sala queda individual.
# Origen del emisor, SIN /api al final. No pongas claves ni secretos en VITE_.
VITE_URL_EMISOR_PASES=https://pases.example.test
VITE_LIVEKIT_URL=wss://voz.example.test
# Sólo desarrollo local con los servicios de pnpm dev:sala:
# VITE_SALA_EN_VIVO=1
# Los agentes de la demo pública usan siempre respuestas de ejemplo locales.
# Origen público del sitio, sin ruta (no es el emisor). Se fija al compilar para OG/WhatsApp.
# Sin esta variable, las etiquetas conservan rutas locales desde la raíz.
# VITE_URL_PUBLICA=https://jules.example.test

# Demo con voz por Meet: sin micrófono, publicación ni suscripción de audio.
# Se aplica al compilar; sin esta variable se conserva la voz habitual.
VITE_SALA_SIN_VOZ=1

# SHA-256 hexadecimal del código de fundador (opcional). Vacío: nadie puede elegir Ónix.
# Exclusividad de interfaz; no equivale a autenticación. Nunca incluir código/hash reales aquí.
VITE_HASH_FUNDADOR=
